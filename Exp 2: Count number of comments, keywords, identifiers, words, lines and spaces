
%{
#include <stdio.h>

int lines = 0;
int words = 0;
int identifiers = 0;
int keywords = 0;
int comments = 0;
int spaces = 0;
%}

keyword    int|float|char|double|if|else|while|for|return|void
ID         [a-zA-Z_][a-zA-Z0-9_]*

%%

{keyword}       { keywords++; words++; }
{ID}            { identifiers++; words++; }
[0-9]+          { words++; }
"//".*          { comments++; }
"/*"([^*]|\*+[^*/])*\*+"/"  { comments++; }
" "             { spaces++; }
\n              { lines++; }
\t              { spaces++; }
.               ;

%%

int yywrap()
{
    return 1;
}

int main()
{
    FILE *fp;
    fp = fopen("input.txt", "r");

    if(fp == NULL)
    {
        printf("File not found!");
        return 1;
    }

    yyin = fp;
    yylex();

    printf("\nLines = %d", lines);
    printf("\nWords = %d", words);
    printf("\nIdentifiers = %d", identifiers);
    printf("\nKeywords = %d", keywords);
    printf("\nComments = %d", comments);
    printf("\nSpaces = %d\n", spaces);

    fclose(fp);
    return 0;
}

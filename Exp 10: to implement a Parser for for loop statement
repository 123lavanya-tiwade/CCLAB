LEX PROGRAM

%{
#include <stdio.h>
#include "y.tab.h"
%}

%%

"for"           { return FOR; }
[a-zA-Z_][a-zA-Z0-9_]*  { return ID; }
[0-9]+          { return NUM; }
"<="|">="|"=="|"!="|"<"|">"  { return RELOP; }
[ \t\n]         ;
.               { return yytext[0]; }

%%

int yywrap()
{
    return 1;
}

YACC PROGRAM

%{
#include <stdio.h>
#include <stdlib.h>

int yylex(void);
int yyerror(char *);
%}

%token FOR ID NUM RELOP

%%

S : FOR '(' A ';' B ';' C ')' '{' '}'
    {
        printf("Valid FOR loop statement\n");
    }
  ;

A : ID '=' NUM
  ;

B : ID RELOP NUM
  ;

C : ID '=' ID '+' NUM
  | ID '=' ID '-' NUM
  | ID '=' NUM
  | ID
  ;

%%

int yyerror(char *s)
{
    printf("Invalid FOR loop statement\n");
    return 0;
}

int main()
{
    printf("Enter FOR loop statement:\n");
    yyparse();
    return 0;
}

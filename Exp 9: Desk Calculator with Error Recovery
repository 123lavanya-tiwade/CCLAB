LEX PROGRAM

%{
#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include "y.tab.h"
%}

%%

[0-9]+       { yylval = atoi(yytext); return NUMBER; }

[+\-*/()]    { return yytext[0]; }

\n           { return '\n'; }

[ \t]        ;

.            { return yytext[0]; }

%%

int yywrap()
{
    return 1;
}

YACC PROGRAM

%{
#include <stdio.h>
#include <stdlib.h>
#include <math.h>

int yylex(void);
int yyerror(char *);
%}

%token NUMBER

%left '+' '-'
%left '*' '/'
%right UMINUS

%%

input:
      input line
    |
    ;

line:
      E '\n'       { printf("Result = %d\n", $1); }
    | error '\n'   { printf("Invalid Expression\n"); yyerrok; }
    ;

E:
      E '+' E      { $$ = $1 + $3; }
    | E '-' E      { $$ = $1 - $3; }
    | E '*' E      { $$ = $1 * $3; }
    | E '/' E      {
                       if($3 == 0)
                       {
                           printf("Division by zero\n");
                           $$ = 0;
                       }
                       else
                           $$ = $1 / $3;
                    }
    | '-' E %prec UMINUS { $$ = -$2; }
    | '(' E ')'    { $$ = $2; }
    | NUMBER       { $$ = $1; }
    ;

%%

int yyerror(char *s)
{
    return 0;
}

int main()
{
    printf("Enter expressions (Ctrl+D to stop):\n");
    yyparse();
    return 0;
}
